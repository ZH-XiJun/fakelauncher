<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/menu_manager_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MenuManagerActivity">

    <!-- 顶部标题栏（标题居左；无返回按钮，纯触屏页用系统返回） -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/mm_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/menu_manager_title" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mm_app_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="8dp" />

    <!-- 底部页面菜单（M3 TabLayout） -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/mm_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mm_tab_bg"
        app:tabGravity="fill"
        app:tabIndicatorColor="?attr/colorPrimary"
        app:tabMode="fixed"
        app:tabSelectedTextColor="?attr/colorPrimary"
        app:tabTextColor="@color/mm_on_card_variant" />

</LinearLayout>
