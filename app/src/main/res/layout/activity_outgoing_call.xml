<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".OutgoingCallActivity">

    <!-- 中央内容：状态大字 → 号码小字 → 图标 → 计时 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="30dp"
        android:paddingBottom="90dp">

        <!-- 状态大字：拨号中 / 通话中 -->
        <TextView
            android:id="@+id/out_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:gravity="center"
            android:singleLine="true"
            android:text="@string/fake_incall_dialing"
            android:textColor="@color/white"
            android:textSize="44sp"
            android:textStyle="bold" />

        <!-- 号码小字 -->
        <TextView
            android:id="@+id/out_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="marquee"
            android:gravity="center"
            android:singleLine="true"
            android:text="@string/fake_incall_unknown"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:alpha="0.7" />

        <!-- 通话图标 -->
        <ImageView
            android:id="@+id/out_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="26dp"
            android:contentDescription="@string/fake_incall_status"
            android:src="@drawable/ic_menu_call" />

        <!-- 通话计时（接通后显示） -->
        <TextView
            android:id="@+id/out_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="00:00"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:visibility="gone" />

        <!-- 提示（接通后显示"通话中 按任意键挂断"，与呼入一致） -->
        <TextView
            android:id="@+id/out_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alpha="0.7"
            android:text="@string/incoming_active_hint"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 左下角：免提/手机（通话中显示） -->
    <TextView
        android:id="@+id/btn_speaker"
        android:layout_width="110dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/btn_incall"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/speaker_on"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 右下角：挂断 -->
    <TextView
        android:id="@+id/btn_hangup"
        android:layout_width="110dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/btn_incall"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/incoming_hangup"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

</FrameLayout>
