<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/Volume"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.VolumeActivity"
    tools:ignore="HardcodedText">

    <!-- 标题（顶部） -->
    <TextView
        android:id="@+id/volume_adjust"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/volume_adjust"
        android:textAlignment="center"
        android:textColor="@color/white"
        app:autoSizeTextType="uniform" />

    <!-- 图标：固定大小，弹性容器使其居中于标题和进度条之间 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <ImageView
            android:id="@+id/volume_logo"
            android:layout_width="160dp"
            android:layout_height="160dp"
            app:srcCompat="@drawable/ic_volume_speaker_on" />
    </LinearLayout>

    <!-- 进度条 + 数字（作为一个整体） -->
    <ProgressBar
        android:id="@+id/volumeBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="50" />

    <TextView
        android:id="@+id/volumeLevel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="100"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="42sp" />

    <!-- 数字底部与按钮栏顶部的固定间隙（往上一点） -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="20dp" />

    <!-- 底部按钮栏 -->
    <LinearLayout
        android:id="@+id/volume_ActionBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/volume_leftButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/edittext_rightButton"
            android:textColor="@color/white"
            android:textAlignment="textStart"
            app:autoSizeTextType="uniform" />

        <TextView
            android:id="@+id/volume_rightButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/save_leftButton"
            android:textColor="@color/white"
            android:textAlignment="textEnd"
            app:autoSizeTextType="uniform" />
    </LinearLayout>
</LinearLayout>
