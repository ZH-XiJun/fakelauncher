<?xml version="1.0" encoding="utf-8"?>
<!-- 菜单管理列表项（Material 3 卡片）：已添加的应用由代码换成 primaryContainer 底 + primary 描边 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mm_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="false"
    app:cardBackgroundColor="@color/mm_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:rippleColor="?attr/colorPrimary"
    app:strokeColor="@color/mm_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/mm_item_icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="@string/menu_manager_title" />

        <TextView
            android:id="@+id/mm_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/mm_on_card"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/mm_item_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/mm_pill_normal"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="@color/mm_pill_text"
            android:textSize="12sp" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
